{
  "openapi": "3.0.3",
  "info": {
    "title": "IceStock API",
    "version": "1.1.0",
    "description": "REST API alineada con `docs/endpoints.md`. Respuestas JSON bajo `/api`. Autenticación: sesión Better Auth (cookie `better-auth.session_token`). **Autorización:** matriz de permisos por `user.rol` (`cliente`, `cajero`, `analista`, `admin`, `superadmin`) — ver `docs/endpoints.md#permisos-por-rol` y extensiones `x-icestock-permission` en cada operación."
  },
  "servers": [{ "url": "http://localhost:3000" }],
  "tags": [
    { "name": "Categorías" },
    { "name": "Productos" },
    { "name": "Proveedores" },
    { "name": "Clientes" },
    { "name": "Ventas" },
    { "name": "Empleados" },
    { "name": "Reportes" },
    { "name": "Meta" },
    { "name": "Upload" },
    { "name": "Permisos", "description": "Matriz rol → permiso HTTP (implementación: src/lib/api/permissions.ts)" }
  ],
  "components": {
    "securitySchemes": {
      "betterAuthCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token",
        "description": "Cookie de sesión emitida por Better Auth (`sign-in/email`)."
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "No autenticado",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorJson" } } }
      },
      "Forbidden": {
        "description": "Sin permiso según matriz de roles",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorJson" } } }
      }
    },
    "schemas": {
      "Rol": {
        "type": "string",
        "enum": ["cliente", "cajero", "analista", "admin", "superadmin"],
        "description": "Campo `user.rol` en Better Auth."
      },
      "Permission": {
        "type": "string",
        "enum": [
          "meta:dashboard",
          "catalog:read_public",
          "catalog:read",
          "catalog:write",
          "catalog:upload",
          "clients:me",
          "clients:read",
          "clients:write",
          "sales:read",
          "sales:create_pos",
          "sales:create_self",
          "sales:void",
          "reports:read",
          "staff:read",
          "staff:write",
          "staff:invite"
        ]
      },
      "ErrorJson": {
        "type": "object",
        "properties": { "error": { "type": "string" } },
        "required": ["error"]
      },
      "Uuid": {
        "type": "string",
        "format": "uuid",
        "description": "Identificador UUID (PK/FK en tablas de negocio)."
      },
      "Categoria": {
        "type": "object",
        "properties": {
          "id": { "$ref": "#/components/schemas/Uuid" },
          "nombre": { "type": "string" },
          "descripcion": { "type": "string", "nullable": true }
        }
      },
      "Producto": {
        "type": "object",
        "properties": {
          "id": { "$ref": "#/components/schemas/Uuid" },
          "nombre": { "type": "string" },
          "descripcion": { "type": "string", "nullable": true },
          "precio": { "type": "string", "example": "15.00" },
          "stock": { "type": "integer" },
          "activo": { "type": "boolean" },
          "categoria": {
            "type": "object",
            "properties": {
              "id": { "$ref": "#/components/schemas/Uuid" },
              "nombre": { "type": "string" }
            }
          },
          "proveedor": {
            "type": "object",
            "properties": {
              "id": { "$ref": "#/components/schemas/Uuid" },
              "nombre": { "type": "string" }
            }
          },
          "imagen_url": { "type": "string", "nullable": true, "description": "URL pública de la foto (p. ej. Cloudinary o CDN)" }
        }
      }
    }
  },
  "security": [{ "betterAuthCookie": [] }],
  "paths": {
    "/api/": {
      "get": {
        "tags": ["Meta"],
        "summary": "Resumen dashboard (datos demo + enlaces OpenAPI)",
        "description": "Sin sesión usa permiso efectivo de analista en BD. Con sesión: `meta:dashboard` (analista, admin, superadmin).",
        "x-icestock-permission": "meta:dashboard",
        "x-icestock-roles": ["analista", "admin", "superadmin"],
        "security": [],
        "responses": {
          "200": { "description": "Payload con `data` agregada para UI tipo dashboard" }
        }
      }
    },
    "/api/docs": {
      "get": {
        "tags": ["Meta"],
        "summary": "Documentación interactiva (Swagger UI)",
        "security": [],
        "responses": {
          "200": {
            "description": "Página HTML con Swagger UI; el contrato OpenAPI está en `/openapi.json`",
            "content": {
              "text/html": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/api/categorias": {
      "get": {
        "tags": ["Categorías"],
        "summary": "Listar categorías",
        "description": "Lectura pública (sin cookie).",
        "x-icestock-permission": "catalog:read",
        "security": [],
        "responses": {
          "200": { "description": "OK" }
        }
      },
      "post": {
        "tags": ["Categorías"],
        "summary": "Crear categoría",
        "x-icestock-permission": "catalog:write",
        "x-icestock-roles": ["admin", "superadmin"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["nombre"], "properties": { "nombre": { "type": "string" }, "descripcion": { "type": "string" } } }
            }
          }
        },
        "responses": {
          "201": { "description": "Creada" },
          "400": { "description": "Validación", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorJson" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/categorias/{id}": {
      "put": {
        "tags": ["Categorías"],
        "summary": "Actualizar categoría",
        "x-icestock-permission": "catalog:write",
        "x-icestock-roles": ["admin", "superadmin"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } }],
        "responses": {
          "200": { "description": "OK" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "description": "No encontrada" }
        }
      },
      "delete": {
        "tags": ["Categorías"],
        "summary": "Eliminar categoría (409 si hay productos)",
        "x-icestock-permission": "catalog:write",
        "x-icestock-roles": ["admin", "superadmin"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } }],
        "responses": { "200": { "description": "Eliminada" }, "409": { "description": "Conflicto FK" } }
      }
    },
    "/api/productos": {
      "get": {
        "tags": ["Productos"],
        "summary": "Listar productos (filtros opcionales)",
        "description": "Sin sesión: catálogo activo (`catalog:read_public`). Con sesión: `catalog:read`. Filtros `stock_bajo` / `incluir_inactivos` requieren personal (`sales:read` o `catalog:write`).",
        "x-icestock-permission": "catalog:read_public",
        "security": [],
        "parameters": [
          { "name": "categoria", "in": "query", "schema": { "$ref": "#/components/schemas/Uuid" }, "description": "Filtrar por id de categoría" },
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "stock_bajo", "in": "query", "schema": { "type": "boolean" } },
          { "name": "incluir_inactivos", "in": "query", "schema": { "type": "boolean" } }
        ],
        "responses": { "200": { "description": "Lista", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Producto" } } } } } }
      },
      "post": {
        "tags": ["Productos"],
        "summary": "Crear producto",
        "x-icestock-permission": "catalog:write",
        "x-icestock-roles": ["admin", "superadmin"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nombre", "precio", "id_categoria", "id_proveedor"],
                "properties": {
                  "nombre": { "type": "string" },
                  "descripcion": { "type": "string", "nullable": true },
                  "precio": { "type": "number", "exclusiveMinimum": 0 },
                  "stock": { "type": "integer", "minimum": 0 },
                  "id_categoria": { "$ref": "#/components/schemas/Uuid" },
                  "id_proveedor": { "$ref": "#/components/schemas/Uuid" },
                  "imagen_url": { "type": "string", "nullable": true }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Creado" },
          "400": { "description": "Validación" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/upload/imagen": {
      "post": {
        "tags": ["Upload"],
        "summary": "Subir imagen a Cloudinary (multipart)",
        "description": "Permiso `catalog:upload`. FormData: `file` (imagen). Opcional: `id_producto` para asignar URL al producto.",
        "x-icestock-permission": "catalog:upload",
        "x-icestock-roles": ["admin", "superadmin"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": { "type": "string", "format": "binary" },
                  "id_producto": { "type": "string", "format": "uuid", "description": "Si se envía, actualiza Producto.imagen_url tras la subida" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "url, public_id, producto (si se asignó)" },
          "400": { "description": "Validación o tipo no permitido" },
          "401": { "description": "No autenticado" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "description": "Cloudinary no configurado" }
        }
      }
    },
    "/api/productos/{id}": {
      "get": {
        "tags": ["Productos"],
        "x-icestock-permission": "catalog:read",
        "x-icestock-roles": ["cliente", "cajero", "analista", "admin", "superadmin"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } }],
        "responses": {
          "200": { "description": "OK" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "description": "No encontrado" }
        }
      },
      "put": {
        "tags": ["Productos"],
        "x-icestock-permission": "catalog:write",
        "x-icestock-roles": ["admin", "superadmin"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } }],
        "responses": {
          "200": { "description": "OK" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "delete": {
        "tags": ["Productos"],
        "summary": "Baja lógica (activo=false)",
        "x-icestock-permission": "catalog:write",
        "x-icestock-roles": ["admin", "superadmin"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } }],
        "responses": { "200": { "description": "Desactivado" } }
      }
    },
    "/api/proveedores": {
      "get": {
        "tags": ["Proveedores"],
        "summary": "Listar proveedores",
        "x-icestock-permission": "catalog:read",
        "x-icestock-roles": ["cliente", "cajero", "analista", "admin", "superadmin"],
        "responses": { "200": { "description": "OK" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      },
      "post": {
        "tags": ["Proveedores"],
        "summary": "Crear proveedor",
        "x-icestock-permission": "catalog:write",
        "x-icestock-roles": ["admin", "superadmin"],
        "responses": { "201": { "description": "Creado" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/api/proveedores/{id}": {
      "put": {
        "tags": ["Proveedores"],
        "x-icestock-permission": "catalog:write",
        "x-icestock-roles": ["admin", "superadmin"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } }],
        "responses": { "200": { "description": "OK" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      },
      "delete": {
        "tags": ["Proveedores"],
        "x-icestock-permission": "catalog:write",
        "x-icestock-roles": ["admin", "superadmin"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } }],
        "responses": { "200": { "description": "OK" }, "409": { "description": "Tiene productos" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/api/clientes/me": {
      "get": {
        "tags": ["Clientes"],
        "summary": "Perfil del cliente autenticado",
        "x-icestock-permission": "clients:me",
        "x-icestock-roles": ["cliente"],
        "responses": { "200": { "description": "OK" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/api/clientes/me/ventas": {
      "get": {
        "tags": ["Clientes"],
        "summary": "Historial de compras del cliente autenticado",
        "x-icestock-permission": "clients:me",
        "x-icestock-roles": ["cliente"],
        "responses": { "200": { "description": "OK" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/api/clientes": {
      "get": {
        "tags": ["Clientes"],
        "summary": "Listar clientes",
        "x-icestock-permission": "clients:read",
        "x-icestock-roles": ["cajero", "analista", "admin", "superadmin"],
        "responses": { "200": { "description": "OK" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      },
      "post": {
        "tags": ["Clientes"],
        "summary": "Crear cliente",
        "x-icestock-permission": "clients:write",
        "x-icestock-roles": ["cajero", "admin", "superadmin"],
        "responses": { "201": { "description": "Creado" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/api/clientes/{id}": {
      "get": {
        "tags": ["Clientes"],
        "summary": "Detalle + estadísticas de compras",
        "x-icestock-permission": "clients:read",
        "x-icestock-roles": ["cajero", "analista", "admin", "superadmin"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } }],
        "responses": { "200": { "description": "OK" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      },
      "put": {
        "tags": ["Clientes"],
        "x-icestock-permission": "clients:write",
        "x-icestock-roles": ["cajero", "admin", "superadmin"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } }],
        "responses": { "200": { "description": "OK" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      },
      "delete": {
        "tags": ["Clientes"],
        "x-icestock-permission": "clients:write",
        "x-icestock-roles": ["cajero", "admin", "superadmin"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } }],
        "responses": { "200": { "description": "OK" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/api/ventas": {
      "get": {
        "tags": ["Ventas"],
        "summary": "Listar ventas (rango de fechas opcional)",
        "x-icestock-permission": "sales:read",
        "x-icestock-roles": ["cajero", "analista", "admin", "superadmin"],
        "parameters": [
          { "name": "fecha_inicio", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "fecha_fin", "in": "query", "schema": { "type": "string", "format": "date" } }
        ],
        "responses": { "200": { "description": "OK" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      },
      "post": {
        "tags": ["Ventas"],
        "summary": "Registrar venta (transacción + stock)",
        "description": "Permiso `sales:create_pos` (cajero, admin, superadmin) o `sales:create_self` (cliente). Con POS se vincula vendedor en servidor; compra en línea deja vendedor null.",
        "x-icestock-permission": "sales:create_pos | sales:create_self",
        "x-icestock-roles": ["cliente", "cajero", "admin", "superadmin"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id_cliente": { "type": "string", "format": "uuid", "nullable": true, "description": "Cliente registrado; omitir o null = mostrador" },
                  "items": { "type": "array", "items": { "type": "object", "required": ["id_producto", "cantidad"], "properties": { "id_producto": { "$ref": "#/components/schemas/Uuid" }, "cantidad": { "type": "integer", "minimum": 1 } } } }
                },
                "required": ["items"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Creada" },
          "400": { "description": "Stock u otra validación" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/ventas/{id}": {
      "get": {
        "tags": ["Ventas"],
        "x-icestock-permission": "sales:read",
        "x-icestock-roles": ["cajero", "analista", "admin", "superadmin"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } }],
        "responses": { "200": { "description": "Detalle con líneas" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      },
      "delete": {
        "tags": ["Ventas"],
        "summary": "Anular venta y restaurar stock",
        "x-icestock-permission": "sales:void",
        "x-icestock-roles": ["admin", "superadmin"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } }],
        "responses": { "200": { "description": "Anulada" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/api/empleados": {
      "get": {
        "tags": ["Empleados"],
        "summary": "Listar empleados",
        "x-icestock-permission": "staff:read",
        "x-icestock-roles": ["admin", "superadmin"],
        "responses": { "200": { "description": "OK" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      },
      "post": {
        "tags": ["Empleados"],
        "summary": "Alta empleado (user + account + fila Empleado)",
        "description": "Permiso `staff:write`. Roles asignables: admin → cajero|admin; superadmin → cajero|analista|admin.",
        "x-icestock-permission": "staff:write",
        "x-icestock-roles": ["admin", "superadmin"],
        "responses": { "201": { "description": "Creado" }, "400": { "description": "Email duplicado o rol no permitido" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/api/empleados/{userId}": {
      "put": {
        "tags": ["Empleados"],
        "x-icestock-permission": "staff:write",
        "x-icestock-roles": ["admin", "superadmin"],
        "parameters": [{ "name": "userId", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Id de usuario Better Auth" }],
        "responses": { "200": { "description": "OK" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      },
      "delete": {
        "tags": ["Empleados"],
        "summary": "Desactivar empleado",
        "x-icestock-permission": "staff:write",
        "x-icestock-roles": ["admin", "superadmin"],
        "parameters": [{ "name": "userId", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Id de usuario Better Auth" }],
        "responses": { "200": { "description": "OK" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/api/reportes/ventas-del-dia": {
      "get": {
        "tags": ["Reportes"],
        "summary": "Agregación ventas del día (vista + totales)",
        "x-icestock-permission": "reports:read",
        "x-icestock-roles": ["analista", "admin", "superadmin"],
        "parameters": [{ "name": "fecha", "in": "query", "schema": { "type": "string", "format": "date" } }],
        "responses": { "200": { "description": "total_ventas, ingresos, detalle" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/api/reportes/productos-mas-vendidos": {
      "get": {
        "tags": ["Reportes"],
        "summary": "Ranking por ingresos (CTE)",
        "x-icestock-permission": "reports:read",
        "x-icestock-roles": ["analista", "admin", "superadmin"],
        "parameters": [
          { "name": "fecha_inicio", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "fecha_fin", "in": "query", "schema": { "type": "string", "format": "date" } }
        ],
        "responses": { "200": { "description": "OK" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/api/reportes/stock-disponible": {
      "get": {
        "tags": ["Reportes"],
        "summary": "Stock con bandera alerta (<20)",
        "x-icestock-permission": "reports:read",
        "x-icestock-roles": ["analista", "admin", "superadmin"],
        "responses": { "200": { "description": "OK" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/api/reportes/ventas-por-categoria": {
      "get": {
        "tags": ["Reportes"],
        "summary": "GROUP BY categoría + HAVING",
        "x-icestock-permission": "reports:read",
        "x-icestock-roles": ["analista", "admin", "superadmin"],
        "responses": { "200": { "description": "OK" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/api/reportes/clientes-frecuentes": {
      "get": {
        "tags": ["Reportes"],
        "summary": "Clientes con >3 compras (subquery)",
        "x-icestock-permission": "reports:read",
        "x-icestock-roles": ["analista", "admin", "superadmin"],
        "responses": { "200": { "description": "OK" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    }
  }
}
