# IceStock — Proyecto 3
# usuario DB proy3, contraseña secret
#
# Docker :
#   cp .env.example .env
#   docker compose up
#
# Desarrollo en el host contra Postgres en Docker (puerto 5433):
#   use DATABASE_URL con localhost:5433 

# --- Docker Compose (servicio db) ---
VITE_DB_USER=proy3
VITE_DB_PASSWORD=secret
VITE_DB_NAME=icestock
VITE_DB_HOST=db
VITE_DB_PORT=5432

# App en contenedor (hostname db)
VITE_DATABASE_URL=postgres://proy3:secret@db:5432/icestock
DATABASE_URL=postgres://proy3:secret@db:5432/icestock

# App en el host → Postgres del compose
# VITE_DB_HOST=localhost
# VITE_DATABASE_URL=postgres://proy3:secret@localhost:5433/icestock
# DATABASE_URL=postgres://proy3:secret@localhost:5433/icestock

# Better Auth (obligatorio: secreto largo en producción)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# BETTER_AUTH_TRUSTED_ORIGINS=https://tu-dominio

# Cloudinary (opcional)
# CLOUDINARY_URL=

# --- Producción (Neon, etc.) ---
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
