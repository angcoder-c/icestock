DB_USER=proy2
DB_PASSWORD=secret
DB_NAME=icestock
DB_HOST=localhost
DB_PORT=5432

# Docker environment variables (VITE_ prefix for app container)
VITE_DB_USER=proy2
VITE_DB_PASSWORD=secret
VITE_DB_NAME=icestock
VITE_DB_HOST=db
VITE_DB_PORT=5432

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Optional single-URL database config
DATABASE_URL=postgres://proy2:secret@localhost:5432/icestock

# Cloudinary (subida de fotos — solo servidor). Formato oficial:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@cloud_name
CLOUDINARY_URL=