{
  "openapi": "3.0.3",
  "info": {
    "title": "IceStock API",
    "version": "1.0.0",
    "description": "REST API alineada con `docs/endpoints.md`. Todas las respuestas de negocio bajo `/api` son JSON (`application/json`). Autenticación: sesión Better Auth (cookie). Tras `POST /api/auth/sign-in/email`, el navegador envia la cookie automáticamente."
  },
  "servers": [{ "url": "http://localhost:3000" }],
  "tags": [
    { "name": "Categorías" },
    { "name": "Productos" },
    { "name": "Proveedores" },
    { "name": "Clientes" },
    { "name": "Ventas" },
    { "name": "Empleados" },
    { "name": "Reportes" },
    { "name": "Meta" },
    { "name": "Upload" }
  ],
  "components": {
    "securitySchemes": {
      "betterAuthCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token",
        "description": "Cookie de sesión emitida por Better Auth (`sign-in/email`)."
      }
    },
    "schemas": {
      "ErrorJson": {
        "type": "object",
        "properties": { "error": { "type": "string" } },
        "required": ["error"]
      },
      "Uuid": {
        "type": "string",
        "format": "uuid",
        "description": "Identificador UUID (PK/FK en tablas de negocio)."
      },
      "Categoria": {
        "type": "object",
        "properties": {
          "id": { "$ref": "#/components/schemas/Uuid" },
          "nombre": { "type": "string" },
          "descripcion": { "type": "string", "nullable": true }
        }
      },
      "Producto": {
        "type": "object",
        "properties": {
          "id": { "$ref": "#/components/schemas/Uuid" },
          "nombre": { "type": "string" },
          "descripcion": { "type": "string", "nullable": true },
          "precio": { "type": "string", "example": "15.00" },
          "stock": { "type": "integer" },
          "activo": { "type": "boolean" },
          "categoria": {
            "type": "object",
            "properties": {
              "id": { "$ref": "#/components/schemas/Uuid" },
              "nombre": { "type": "string" }
            }
          },
          "proveedor": {
            "type": "object",
            "properties": {
              "id": { "$ref": "#/components/schemas/Uuid" },
              "nombre": { "type": "string" }
            }
          },
          "imagen_url": { "type": "string", "nullable": true, "description": "URL pública de la foto (p. ej. Cloudinary o CDN)" }
        }
      }
    }
  },
  "security": [{ "betterAuthCookie": [] }],
  "paths": {
    "/api/": {
      "get": {
        "tags": ["Meta"],
        "summary": "Resumen dashboard (datos demo + enlaces OpenAPI)",
        "security": [],
        "responses": {
          "200": { "description": "Payload con `data` agregada para UI tipo dashboard" }
        }
      }
    },
    "/api/docs": {
      "get": {
        "tags": ["Meta"],
        "summary": "Documentación interactiva (Swagger UI)",
        "security": [],
        "responses": {
          "200": {
            "description": "Página HTML con Swagger UI; el contrato OpenAPI está en `/openapi.json`",
            "content": {
              "text/html": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/api/categorias": {
      "get": {
        "tags": ["Categorías"],
        "summary": "Listar categorías",
        "responses": {
          "200": { "description": "OK" },
          "401": { "description": "No autenticado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorJson" } } } }
        }
      },
      "post": {
        "tags": ["Categorías"],
        "summary": "Crear categoría",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["nombre"], "properties": { "nombre": { "type": "string" }, "descripcion": { "type": "string" } } }
            }
          }
        },
        "responses": {
          "201": { "description": "Creada" },
          "400": { "description": "Validación", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorJson" } } } },
          "401": { "description": "No autenticado" }
        }
      }
    },
    "/api/categorias/{id}": {
      "put": {
        "tags": ["Categorías"],
        "summary": "Actualizar categoría",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } }],
        "responses": { "200": { "description": "OK" }, "404": { "description": "No encontrada" } }
      },
      "delete": {
        "tags": ["Categorías"],
        "summary": "Eliminar categoría (409 si hay productos)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } }],
        "responses": { "200": { "description": "Eliminada" }, "409": { "description": "Conflicto FK" } }
      }
    },
    "/api/productos": {
      "get": {
        "tags": ["Productos"],
        "summary": "Listar productos (filtros opcionales)",
        "parameters": [
          { "name": "categoria", "in": "query", "schema": { "$ref": "#/components/schemas/Uuid" }, "description": "Filtrar por id de categoría" },
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "stock_bajo", "in": "query", "schema": { "type": "boolean" } },
          { "name": "incluir_inactivos", "in": "query", "schema": { "type": "boolean" } }
        ],
        "responses": { "200": { "description": "Lista", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Producto" } } } } } }
      },
      "post": {
        "tags": ["Productos"],
        "summary": "Crear producto",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nombre", "precio", "id_categoria", "id_proveedor"],
                "properties": {
                  "nombre": { "type": "string" },
                  "descripcion": { "type": "string", "nullable": true },
                  "precio": { "type": "number", "exclusiveMinimum": 0 },
                  "stock": { "type": "integer", "minimum": 0 },
                  "id_categoria": { "$ref": "#/components/schemas/Uuid" },
                  "id_proveedor": { "$ref": "#/components/schemas/Uuid" },
                  "imagen_url": { "type": "string", "nullable": true }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Creado" }, "400": { "description": "Validación" } }
      }
    },
    "/api/upload/imagen": {
      "post": {
        "tags": ["Upload"],
        "summary": "Subir imagen a Cloudinary (multipart)",
        "description": "Requiere sesión de personal (admin/cajero). FormData: campo `file` (imagen). Opcional: `id_producto` para asignar la URL al producto.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": { "type": "string", "format": "binary" },
                  "id_producto": { "type": "string", "format": "uuid", "description": "Si se envía, actualiza Producto.imagen_url tras la subida" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "url, public_id, producto (si se asignó)" },
          "400": { "description": "Validación o tipo no permitido" },
          "401": { "description": "No autenticado" },
          "403": { "description": "Solo personal" },
          "503": { "description": "Cloudinary no configurado" }
        }
      }
    },
    "/api/productos/{id}": {
      "get": {
        "tags": ["Productos"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } }],
        "responses": { "200": { "description": "OK" }, "404": { "description": "No encontrado" } }
      },
      "put": {
        "tags": ["Productos"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } }],
        "responses": { "200": { "description": "OK" } }
      },
      "delete": {
        "tags": ["Productos"],
        "summary": "Baja lógica (activo=false)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } }],
        "responses": { "200": { "description": "Desactivado" } }
      }
    },
    "/api/proveedores": {
      "get": { "tags": ["Proveedores"], "summary": "Listar proveedores", "responses": { "200": { "description": "OK" } } },
      "post": { "tags": ["Proveedores"], "summary": "Crear proveedor", "responses": { "201": { "description": "Creado" } } }
    },
    "/api/proveedores/{id}": {
      "put": { "tags": ["Proveedores"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } }], "responses": { "200": { "description": "OK" } } },
      "delete": { "tags": ["Proveedores"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } }], "responses": { "200": { "description": "OK" }, "409": { "description": "Tiene productos" } } }
    },
    "/api/clientes": {
      "get": { "tags": ["Clientes"], "summary": "Listar clientes", "responses": { "200": { "description": "OK" } } },
      "post": { "tags": ["Clientes"], "summary": "Crear cliente", "responses": { "201": { "description": "Creado" } } }
    },
    "/api/clientes/{id}": {
      "get": { "tags": ["Clientes"], "summary": "Detalle + estadísticas de compras", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } }], "responses": { "200": { "description": "OK" } } },
      "put": { "tags": ["Clientes"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } }], "responses": { "200": { "description": "OK" } } },
      "delete": { "tags": ["Clientes"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } }], "responses": { "200": { "description": "OK" } } }
    },
    "/api/ventas": {
      "get": {
        "tags": ["Ventas"],
        "summary": "Listar ventas (rango de fechas opcional)",
        "parameters": [
          { "name": "fecha_inicio", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "fecha_fin", "in": "query", "schema": { "type": "string", "format": "date" } }
        ],
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "tags": ["Ventas"],
        "summary": "Registrar venta (transacción + stock)",
        "description": "empleado_id se guarda en servidor cuando la sesión es admin/cajero; queda null si el cliente compra por su cuenta (rol cliente).",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id_cliente": { "type": "string", "format": "uuid", "nullable": true, "description": "Cliente registrado; omitir o null = mostrador" },
                  "items": { "type": "array", "items": { "type": "object", "required": ["id_producto", "cantidad"], "properties": { "id_producto": { "$ref": "#/components/schemas/Uuid" }, "cantidad": { "type": "integer", "minimum": 1 } } } }
                },
                "required": ["items"]
              }
            }
          }
        },
        "responses": { "201": { "description": "Creada" }, "400": { "description": "Stock u otra validación" } }
      }
    },
    "/api/ventas/{id}": {
      "get": { "tags": ["Ventas"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } }], "responses": { "200": { "description": "Detalle con líneas" } } },
      "delete": {
        "tags": ["Ventas"],
        "summary": "Anular venta y restaurar stock (solo admin)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } }],
        "responses": { "200": { "description": "Anulada" }, "403": { "description": "No admin" } }
      }
    },
    "/api/empleados": {
      "get": { "tags": ["Empleados"], "summary": "Listar empleados (solo admin)", "responses": { "200": { "description": "OK" }, "403": { "description": "No admin" } } },
      "post": { "tags": ["Empleados"], "summary": "Alta empleado (user + account + fila Empleado)", "responses": { "201": { "description": "Creado" }, "400": { "description": "Email duplicado" } } }
    },
    "/api/empleados/{userId}": {
      "put": { "tags": ["Empleados"], "parameters": [{ "name": "userId", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Id de usuario Better Auth" }], "responses": { "200": { "description": "OK" } } },
      "delete": { "tags": ["Empleados"], "summary": "Desactivar empleado", "parameters": [{ "name": "userId", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Id de usuario Better Auth" }], "responses": { "200": { "description": "OK" } } }
    },
    "/api/reportes/ventas-del-dia": {
      "get": {
        "tags": ["Reportes"],
        "summary": "Agregación ventas del día (vista + totales)",
        "parameters": [{ "name": "fecha", "in": "query", "schema": { "type": "string", "format": "date" } }],
        "responses": { "200": { "description": "total_ventas, ingresos, detalle" } }
      }
    },
    "/api/reportes/productos-mas-vendidos": {
      "get": {
        "tags": ["Reportes"],
        "summary": "Ranking por ingresos (CTE)",
        "parameters": [
          { "name": "fecha_inicio", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "fecha_fin", "in": "query", "schema": { "type": "string", "format": "date" } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/reportes/stock-disponible": {
      "get": { "tags": ["Reportes"], "summary": "Stock con bandera alerta (<20)", "responses": { "200": { "description": "OK" } } }
    },
    "/api/reportes/ventas-por-categoria": {
      "get": { "tags": ["Reportes"], "summary": "GROUP BY categoría + HAVING", "responses": { "200": { "description": "OK" } } }
    },
    "/api/reportes/clientes-frecuentes": {
      "get": { "tags": ["Reportes"], "summary": "Clientes con >3 compras (subquery)", "responses": { "200": { "description": "OK" } } }
    }
  }
}
